{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(./gradlew test *)",
      "Bash(./gradlew build *)",
      "Bash(npm run *)",
      "Bash(git check-ignore *)",
      "Bash(curl -s -m 3 localhost:8080/api/health)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)"
    ]
  }
}
